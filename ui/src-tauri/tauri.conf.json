{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gembala",
  "mainBinaryName": "gembala-ui",
  "version": "0.1.9",
  "identifier": "dev.gembala.app",
  "build": {
    "beforeDevCommand": "npm run sidecar && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run sidecar && npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Gembala",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 440,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "externalBin": ["binaries/gembala"],
    "macOS": {
      "signingIdentity": "Gembala Dev",
      "files": {
        "Helpers/Gembala Daemon.app": "binaries/Gembala Daemon.app"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
